=======================================================================
1. 로컬 클러스터에 Postgresql 배포 ( 데이터 서비스 )
=======================================================================

#kubernetes/platform/development 폴더로 이동

#로컬 클러스터에  PostgreSQL을 배포 ( 매니페스트에 정의된 리소스를 생성 )
kubectl apply -f services

#생성된 파드 확인
kubectl get pod


#설치한 객체 삭제
#kubernetes/platform/development 폴더로 이동
kubectl delete -f services




